meta {
  name: Log in from a second client
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  user-agent: Bruno second client
}

body:json {
  {
    "email": "{{ownerEmail}}",
    "password": "{{password}}"
  }
}

tests {
  test("answers 200", function () {
    expect(res.status).to.equal(200);
  });
}
