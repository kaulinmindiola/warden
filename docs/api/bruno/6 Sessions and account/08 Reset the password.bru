meta {
  name: Reset the password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/password/reset
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "{{newPassword}}"
  }
}

tests {
  test("answers 204", function () {
    expect(res.status).to.equal(204);
  });
}
