meta {
  name: Log in with a wrong password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{ownerEmail}}",
    "password": "not the password"
  }
}

tests {
  test("answers 401", function () {
    expect(res.status).to.equal(401);
  });
}
